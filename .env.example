# Handoff configuration
# Copy to .env and adjust. Everything works without AWS using the heuristic provider.

# Model provider: "heuristic" (offline dev/tests) | "bedrock" (Strands agent loop on Claude)
HANDOFF_MODEL_PROVIDER=heuristic

# AWS (required when provider=bedrock)
AWS_REGION=us-west-2
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
HANDOFF_BEDROCK_MODEL_ID=us.anthropic.claude-sonnet-4-5-20250929-v1:0

# Policy
HANDOFF_APPROVAL_THRESHOLD=400

# Local state directory (file store)
HANDOFF_DATA_DIR=data/runtime
